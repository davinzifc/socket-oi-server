# Server
NODE_ENV=development
PORT=3000
# En dev puedes dejar '*' (en prod restringe a tu dominio)
CORS_ORIGIN=*

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Bull Queue
BULL_LIMITER_MAX=50
BULL_LIMITER_DURATION=1000
BULL_MAX_ATTEMPTS=3
BULL_BACKOFF_DELAY=2000

# Socket.IO
SOCKET_PING_TIMEOUT=20000
SOCKET_PING_INTERVAL=5000
# Habilitar solo si corres múltiples instancias del servidor
SOCKET_REDIS_ADAPTER_ENABLED=false

# Processor
PROCESSOR_CONCURRENCY_SINGLE=10
PROCESSOR_CONCURRENCY_BATCH=5
SUB_BATCH_SIZE=50
SUB_BATCH_DELAY_MS=10

# Presence (Redis)
# TTL de seguridad para limpiar presencia si el proceso muere sin disconnect (segundos)
PRESENCE_SOCKET_TTL_SECONDS=45

# Estado IDLE (segundos): sin heartbeat reciente pero todavía conectado
PRESENCE_IDLE_AFTER_SECONDS=60

# OFFLINE (segundos): umbral para que el sweeper marque offline por lastSeen
# Si no lo seteas, usa PRESENCE_SOCKET_TTL_SECONDS.
PRESENCE_OFFLINE_AFTER_SECONDS=

# Sweeper (ms): revisa TTL expirados y emite presence:user_offline
PRESENCE_SWEEP_INTERVAL_MS=5000

# Lock sweeper (ms): evita sweeper duplicado en multi-instancia
PRESENCE_SWEEP_LOCK_TTL_MS=15000

# Logging
LOG_LEVEL=debug

# Auth (para facilitar desarrollo local puedes poner false)
AUTH_REQUIRED=false
# Requerido si AUTH_REQUIRED=true (HS256)
AUTH_JWT_SECRET=
# Opcional:
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
# Lista de userIds admin para acciones WS sensibles (csv)
AUTH_ADMIN_USER_IDS=

# WebSocket hardening
WS_RATE_LIMIT_MAX=60
WS_RATE_LIMIT_WINDOW_MS=10000
WS_RATE_LIMIT_BROADCAST_MAX=5
WS_PAYLOAD_MAX_BYTES=65536
# Whitelist opcional para section:emit / broadcast:emit (csv). Si está vacío solo se valida formato y se bloquean prefijos internos.
WS_ALLOWED_CLIENT_EMIT_EVENTS=

# Swagger
# http://localhost:3000/docs
SWAGGER_ENABLED=true

