# Server
NODE_ENV=xxxxx
PORT=xxxxx
CORS_ORIGIN=xxxxx

# Redis
REDIS_HOST=xxxxx
REDIS_PORT=xxxxx
REDIS_PASSWORD=xxxxx
REDIS_DB=xxxxx

# Redis (AWS ElastiCache recomendado)
# Puedes usar REDIS_URL para simplificar (preferido). Ejemplos:
# - Sin TLS: redis://<endpoint>:6379
# - Con TLS:  rediss://<endpoint>:6379
REDIS_URL=xxxxx
# Si tu ElastiCache requiere TLS (recommended/required), habilita:
REDIS_TLS=xxxxx
# Normalmente debe ser true (CA válida). Solo pon false si sabes lo que haces.
REDIS_TLS_REJECT_UNAUTHORIZED=xxxxx

# Redis startup check (fail-fast)
# Si true, el server NO levanta si Redis/ElastiCache no conecta.
REDIS_REQUIRED=xxxxx
# Timeout del check de conexión (ms)
REDIS_CONNECT_TIMEOUT_MS=xxxxx

# Bull Queue
BULL_LIMITER_MAX=xxxxx
BULL_LIMITER_DURATION=xxxxx
BULL_MAX_ATTEMPTS=xxxxx
BULL_BACKOFF_DELAY=xxxxx

# Socket.IO
SOCKET_PING_TIMEOUT=xxxxx
SOCKET_PING_INTERVAL=xxxxx
# Habilitar solo si corres múltiples instancias del servidor
SOCKET_REDIS_ADAPTER_ENABLED=xxxxx

# Processor
PROCESSOR_CONCURRENCY_SINGLE=xxxxx
PROCESSOR_CONCURRENCY_BATCH=xxxxx
SUB_BATCH_SIZE=xxxxx
SUB_BATCH_DELAY_MS=xxxxx

# Presence (Redis)
# TTL de seguridad para limpiar presencia si el proceso muere sin disconnect (segundos)
PRESENCE_SOCKET_TTL_SECONDS=xxxxx

# Logging
LOG_LEVEL=xxxxx

# Auth (para facilitar desarrollo local puedes poner false)
AUTH_REQUIRED=xxxxx

# Swagger
# http://localhost:3000/docs
SWAGGER_ENABLED=xxxxx

